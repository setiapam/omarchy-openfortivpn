#!/bin/bash
# omarchy:summary=Check OpenFortiVPN connection status
# omarchy:args=[config_name]

set -euo pipefail

CONFIG_NAME="${1:-config}"
RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-openfortivpn"
PID_FILE="$RUN_DIR/${CONFIG_NAME}.pid"
CONFIG_FILE="$HOME/.config/openfortivpn/$CONFIG_NAME"

status="disconnected"
pid=""
host=""
uptime_secs="null"

if [[ -f "$CONFIG_FILE" ]]; then
  host=$(grep -i "^host[[:space:]]*=" "$CONFIG_FILE" 2>/dev/null | head -1 | sed 's/^host[[:space:]]*=[[:space:]]*//' | tr -d '[:space:]' || echo "")
fi

# Check if openfortivpn process is running
if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
  pid=$(cat "$PID_FILE")
elif pgrep -x openfortivpn >/dev/null 2>&1; then
  pid=$(pgrep -x openfortivpn | head -1 || echo "")
fi

# Only consider connected if the tunnel interface (ppp0) is UP
if ip link show ppp0 >/dev/null 2>&1; then
  status="connected"
elif [[ -n "$pid" ]] || systemctl --user is-active --quiet omarchy-openfortivpn.service 2>/dev/null; then
  status="connecting"
else
  status="disconnected"
  if [[ -f "$PID_FILE" ]]; then
    rm -f "$PID_FILE"
  fi
fi

if [[ -n "$pid" && -d "/proc/$pid" ]]; then
  start_time=$(stat -c %Y "/proc/$pid" 2>/dev/null || echo "")
  if [[ -n "$start_time" ]]; then
    now=$(date +%s)
    uptime_secs=$(( now - start_time ))
  fi
fi

saml="false"
if [[ -f "$CONFIG_FILE" ]]; then
  if grep -qi "^saml[[:space:]]*=[[:space:]]*true" "$CONFIG_FILE" 2>/dev/null; then
    saml="true"
  fi
fi

webview_available="false"
if command -v openfortivpn-webview >/dev/null 2>&1; then
  webview_available="true"
fi

# Print single-line JSON to prevent SplitParser line-buffering JSON.parse issues
echo "{\"status\":\"$status\",\"pid\":\"$pid\",\"host\":\"$host\",\"config\":\"$CONFIG_NAME\",\"saml\":$saml,\"webviewAvailable\":$webview_available,\"uptimeSeconds\":$uptime_secs}"
