#!/bin/bash
# omarchy:summary=Connect to FortiVPN gateway
# omarchy:args=[config_name]
# omarchy:requires-sudo=true

set -euo pipefail

CONFIG_NAME="${1:-config}"
CONFIG_DIR="$HOME/.config/openfortivpn"
CONFIG_FILE="$CONFIG_DIR/$CONFIG_NAME"
RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-openfortivpn"
mkdir -p "$RUN_DIR"
chmod 700 "$RUN_DIR"
PID_FILE="$RUN_DIR/${CONFIG_NAME}.pid"
LOCK_FILE="$RUN_DIR/${CONFIG_NAME}.lock"

readonly HELPER="/usr/local/lib/omarchy/openfortivpn-helper"
readonly CALLING_USER="$(id -un)"

# Ensure only one instance of the script runs at a time (prevents multi-monitor double-launch)
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "Another instance of openfortivpn-up is already running."
  exit 0
fi

# Validate config name early (mirror the helper's check so we fail fast)
if [[ ! "$CONFIG_NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
  echo "Error: Invalid config name '$CONFIG_NAME'. Only alphanumeric, dots, hyphens, and underscores are allowed."
  exit 1
fi

# Helper for elevated execution via the validated helper script
exec_vpn() {
  local action="$1"; shift
  if sudo -n -l "$HELPER" >/dev/null 2>&1; then
    sudo "$HELPER" "$action" "$CALLING_USER" "$CONFIG_NAME" "$@"
  elif command -v pkexec >/dev/null 2>&1; then
    pkexec "$HELPER" "$action" "$CALLING_USER" "$CONFIG_NAME" "$@"
  else
    sudo "$HELPER" "$action" "$CALLING_USER" "$CONFIG_NAME" "$@"
  fi
}

# Check if openfortivpn binary is installed
if ! command -v openfortivpn >/dev/null 2>&1; then
  echo "Error: openfortivpn is not installed."
  omarchy-notification-send "OpenFortiVPN" "Error: openfortivpn is not installed. Install via: omarchy-pkg-add openfortivpn" 2>/dev/null || true
  exit 1
fi

if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  echo "VPN is already connected (PID: $(cat "$PID_FILE"))"
  exit 0
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "Error: Config file not found: $CONFIG_FILE"
  echo "Create one from the example or edit the default config."
  exit 1
fi

# Read config to check if SAML is needed
USE_SAML=false
if grep -qi "^# saml[[:space:]]*=[[:space:]]*true" "$CONFIG_FILE" 2>/dev/null || \
   grep -qi "^saml[[:space:]]*=[[:space:]]*true" "$CONFIG_FILE" 2>/dev/null; then
  USE_SAML=true
fi

# Extract host, port, and realm from config
VPN_HOST=$(grep -i "^host[[:space:]]*=" "$CONFIG_FILE" | head -1 | sed 's/^host[[:space:]]*=[[:space:]]*//' | tr -d '[:space:]' || true)
VPN_PORT=$(grep -i "^port[[:space:]]*=" "$CONFIG_FILE" | head -1 | sed 's/^port[[:space:]]*=[[:space:]]*//' | tr -d '[:space:]' || true)
VPN_PORT="${VPN_PORT:-443}"
VPN_REALM=$(grep -i "^realm[[:space:]]*=" "$CONFIG_FILE" | head -1 | sed 's/^realm[[:space:]]*=[[:space:]]*//' | tr -d '[:space:]' || true)

connect_with_saml() {
  if ! omarchy-cmd-present openfortivpn-webview; then
    echo "Error: openfortivpn-webview is required for SAML authentication."
    echo "Install it from: https://github.com/gm-vm/openfortivpn-webview"
    omarchy-notification-send "OpenFortiVPN" "SAML Error: openfortivpn-webview is required but not installed." 2>/dev/null || true
    exit 1
  fi

  WEBVIEW_TARGET="${VPN_HOST}:${VPN_PORT}"
  if [[ -n "$VPN_REALM" ]]; then
    # Format target URL with realm if defined (e.g. host:port/realm or host:port --realm realm)
    if [[ "$VPN_REALM" == /* ]]; then
      WEBVIEW_TARGET="${VPN_HOST}:${VPN_PORT}${VPN_REALM}"
    else
      WEBVIEW_TARGET="${VPN_HOST}:${VPN_PORT}/${VPN_REALM}"
    fi
  fi

  echo "==> Launching SAML authentication for ${WEBVIEW_TARGET}..."
  echo "    A browser window will open. Complete the login flow."

  COOKIE=$(openfortivpn-webview "${WEBVIEW_TARGET}" 2>/dev/null)

  if [[ -z "$COOKIE" ]]; then
    echo "Error: Failed to obtain SAML cookie. Authentication may have been cancelled."
    exit 1
  fi

  echo "==> SAML authentication successful. Connecting VPN tunnel..."
  echo "$COOKIE" | exec_vpn cookie-connect &
  VPN_PID=$!
  echo "$VPN_PID" > "$PID_FILE"

  # Wait briefly to check if connection succeeded
  sleep 3
  if kill -0 "$VPN_PID" 2>/dev/null; then
    echo "✓ VPN connected successfully (PID: $VPN_PID)"
    omarchy-notification-send "OpenFortiVPN" "Connected to ${VPN_HOST}" 2>/dev/null || true

    # Enable autostart for SAML on next GUI login
    touch "$HOME/.config/openfortivpn/.saml_autostart"
  else
    rm -f "$PID_FILE"
    echo "✗ VPN connection failed. Check the logs."
    exit 1
  fi
}

connect_with_password() {
  # If sudoers NOPASSWD is configured, use systemd user service for auto-connect across reboots
  if sudo -n -l "$HELPER" >/dev/null 2>&1; then
    echo "==> Connecting to ${VPN_HOST}:${VPN_PORT} via systemd..."
    
    # Ensure the user service file exists
    if [[ ! -f "$HOME/.config/systemd/user/omarchy-openfortivpn.service" ]]; then
      mkdir -p "$HOME/.config/systemd/user"
      cat << EOF > "$HOME/.config/systemd/user/omarchy-openfortivpn.service"
[Unit]
Description=OpenFortiVPN Auto-Connect
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/sudo -n $HELPER connect $CALLING_USER $CONFIG_NAME
ExecStop=/usr/bin/sudo -n $HELPER disconnect
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
EOF
      systemctl --user daemon-reload
    fi

    # Enable and start the service so it persists across reboots
    systemctl --user enable --now omarchy-openfortivpn.service

    # Wait briefly to check if connection succeeded
    sleep 3
    if systemctl --user is-active --quiet omarchy-openfortivpn.service; then
      echo "✓ VPN connected successfully via systemd"
      omarchy-notification-send "OpenFortiVPN" "Connected to ${VPN_HOST}" 2>/dev/null || true
    else
      echo "✗ VPN connection failed. Check 'journalctl --user -xeu omarchy-openfortivpn' for logs."
      exit 1
    fi
  else
    # Fallback to direct execution with Polkit / sudo prompt
    echo "==> Connecting to ${VPN_HOST}:${VPN_PORT}..."
    exec_vpn connect &
    VPN_PID=$!
    echo "$VPN_PID" > "$PID_FILE"

    sleep 3
    if kill -0 "$VPN_PID" 2>/dev/null; then
      echo "✓ VPN connected successfully (PID: $VPN_PID)"
      omarchy-notification-send "OpenFortiVPN" "Connected to ${VPN_HOST}" 2>/dev/null || true
    else
      rm -f "$PID_FILE"
      echo "✗ VPN connection failed. Check your credentials or logs."
      exit 1
    fi
  fi
}

if [[ "$USE_SAML" == "true" ]]; then
  connect_with_saml
else
  connect_with_password
fi
