#!/bin/bash
# omarchy:summary=Disconnect from FortiVPN gateway
# omarchy:args=[config_name]
# omarchy:requires-sudo=true

set -euo pipefail

CONFIG_NAME="${1:-config}"
RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-openfortivpn"
PID_FILE="$RUN_DIR/${CONFIG_NAME}.pid"

exec_sudo() {
  if sudo -n -l "$1" >/dev/null 2>&1; then
    sudo "$@"
  elif command -v pkexec >/dev/null 2>&1; then
    pkexec "$@"
  else
    sudo "$@"
  fi
}

# Check if running via user systemd service
if systemctl --user is-active --quiet omarchy-openfortivpn.service 2>/dev/null; then
  echo "==> Disabling and stopping systemd service..."
  systemctl --user disable --now omarchy-openfortivpn.service
fi

# Remove SAML GUI autostart flag if present
rm -f "$HOME/.config/openfortivpn/.saml_autostart"

# Stop openfortivpn process safely using explicit command without relying on shared PID
exec_sudo pkill -x openfortivpn 2>/dev/null || true
rm -f "$PID_FILE"

echo "✓ VPN disconnected"
omarchy-notification-send "OpenFortiVPN" "Disconnected" 2>/dev/null || true
